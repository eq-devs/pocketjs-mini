#!/bin/bash
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
REV=fe971ebb8e14724d2a98d4df6b34c065caf11132
fail() { echo "pjm: $*" >&2; exit 1; }
usage() { fail 'usage: pjm create <appname> | run [-d device] | clean'; }
[ "$#" -gt 0 ] || usage
command=$1
shift
case "$command" in
  create)
    [ "$#" -eq 1 ] || usage
    name=$1
    case "$name" in ''|[!a-z]*|*[!a-z0-9-]*) fail 'appname must start with a lowercase letter and contain only a-z, 0-9, or -';; esac
    [ "${#name}" -le 48 ] || fail 'appname must be at most 48 characters'
    [ ! -e "$name" ] && [ ! -L "$name" ] || fail "destination already exists: $name"
    mkdir "$name"
    cp -R "$ROOT/template/." "$name/"
    sed "s/APPNAME/$name/g" "$ROOT/template/mini.json" > "$name/mini.json"
    echo "Created $name"
    exit 0
    ;;
  run)
    device=''
    if [ "$#" -ne 0 ]; then
      [ "$#" -eq 2 ] && [ "$1" = '-d' ] && [ -n "$2" ] || usage
      device=$2
    fi
    ;;
  clean) [ "$#" -eq 0 ] || usage;;
  *) usage;;
esac
[ -f mini.json ] && [ ! -L mini.json ] || fail 'run this command in a Mini project (mini.json required)'
if [ "$command" = clean ]; then
  [ ! -L build ] || fail 'refusing to clean a symlinked build directory'
  if [ -f build/session.json ]; then
    running_pid=$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' build/session.json)
    if [ -n "$running_pid" ] && kill -0 "$running_pid" 2>/dev/null; then
      fail 'stop the active pjm run session before cleaning'
    fi
  fi
  rm -rf -- build
  exit 0
fi
command -v bun >/dev/null 2>&1 || fail 'Bun is required: https://bun.sh'
if [ "${PJM_TEST_SERVER:-0}" != 1 ]; then
  command -v flutter >/dev/null 2>&1 || fail 'Flutter is required: https://docs.flutter.dev/install'
  command -v cargo >/dev/null 2>&1 || fail 'Rust/Cargo is required: https://rustup.rs'
fi
mkdir -p .pjm
[ ! -L build ] || fail 'build must not be a symlink'
if [ ! -d .pjm/pocketjs/.git ]; then
  git init -q .pjm/pocketjs
  git -C .pjm/pocketjs remote add origin https://github.com/pocket-nexus/pocketjs.git
fi
if ! git -C .pjm/pocketjs rev-parse --verify HEAD >/dev/null 2>&1; then
  git -C .pjm/pocketjs fetch --depth 1 origin "$REV"
  git -C .pjm/pocketjs checkout --detach "$REV"
fi
[ "$(git -C .pjm/pocketjs rev-parse HEAD)" = "$REV" ] || fail "PocketJS checkout must be pinned to $REV"
if [ ! -f .pjm/pocketjs/node_modules/.pjm-ready ]; then
  (cd .pjm/pocketjs && bun install --frozen-lockfile)
  touch .pjm/pocketjs/node_modules/.pjm-ready
fi
if [ -n "$device" ]; then
  exec bun "$ROOT/bin/runtime.ts" "$PWD/.pjm/pocketjs" "$device"
fi
exec bun "$ROOT/bin/runtime.ts" "$PWD/.pjm/pocketjs"
